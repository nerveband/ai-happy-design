[
  {
    "name": "measure_headline",
    "command": "text.measure",
    "params": {
      "text": "Partnership Packages",
      "width": 760,
      "fontFamily": "Inter",
      "fontStyle": "Bold",
      "fontSize": 58
    }
  },
  {
    "name": "fit_long_tier",
    "command": "text.fit_box",
    "params": {
      "text": "Business Showcase Opportunity",
      "width": 420,
      "height": 74,
      "fontFamily": "Inter",
      "fontStyle": "Bold",
      "minFontSize": 22,
      "maxFontSize": 36
    }
  },
  {
    "name": "canvas",
    "command": "node.create_frame",
    "params": {
      "name": "HTML CSS recreation workflow example",
      "x": 80,
      "y": 80,
      "width": 1200,
      "height": 760,
      "color": "#050606",
      "cornerRadius": 0
    }
  },
  {
    "name": "hero_copy",
    "command": "text.create_rich_block",
    "params": {
      "parentId": "${{steps.canvas.result.id}}",
      "name": "Measured hero copy",
      "x": 40,
      "y": 36,
      "width": 760,
      "fontFamily": "Inter",
      "heading": "PARTNERSHIP PACKAGES",
      "price": "High-fidelity recreation workflow",
      "benefits": [
        "Measure text first",
        "Fit long labels",
        "Create semantic rich blocks",
        "Iterate visually after export"
      ],
      "headingStyle": {
        "fontSize": 58,
        "fontWeight": 800,
        "color": "#E5AD43",
        "lineHeight": 1
      },
      "priceStyle": {
        "fontSize": 24,
        "fontWeight": 700,
        "color": "#F8F4EC",
        "lineHeight": 1.1
      },
      "bodyStyle": {
        "fontSize": 18,
        "fontWeight": 400,
        "color": "#D9D2C5",
        "lineHeight": 1.35
      }
    }
  },
  {
    "name": "pricing_grid",
    "command": "layout.pricing_grid",
    "params": {
      "parentId": "${{steps.canvas.result.id}}",
      "name": "Measured pricing grid",
      "x": 40,
      "y": 230,
      "width": 1120,
      "columns": 3,
      "gap": 28,
      "rowGap": 36,
      "cards": [
        {
          "name": "Diamond pricing card",
          "heading": "Diamond",
          "price": "$10,000",
          "benefits": [
            "Full page ad in program booklet",
            "Double booth in prefunction area",
            "Two guest tables with 10 seats each"
          ]
        },
        {
          "name": "Platinum pricing card",
          "heading": "Platinum",
          "price": "$5,000",
          "benefits": [
            "Half page ad in program booklet",
            "Double booth in prefunction area",
            "One guest table with 10 seats"
          ]
        },
        {
          "name": "Business showcase pricing card",
          "heading": "Business Showcase Opportunity",
          "price": "Limited to 10",
          "benefits": [
            "Samples for all attendees",
            "One booth",
            "Two guest tickets"
          ],
          "headingStyle": {
            "fontSize": "${{steps.fit_long_tier.result.fontSize}}"
          }
        }
      ]
    }
  }
]
