      "eyebrow": {
        "fontFamily": "{font.display}",
        "fontSize": 25,
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": 8,
        "textTransform": "uppercase"
      },
      "title": {
        "fontFamily": "{font.display}",
        "fontSize": 58,
        "fontWeight": 500,
        "lineHeight": 1,
        "letterSpacing": 9,
        "textTransform": "uppercase"
      },
      "tierName": {
        "fontFamily": "{font.display}",
        "fontSize": 36,
        "fontWeight": 800,
        "lineHeight": 0.95,
        "letterSpacing": 1.5,
        "textTransform": "uppercase"
      },
      "price": {
        "fontFamily": "{font.display}",
        "fontSize": 24,
        "fontWeight": 800,
        "lineHeight": 1.05,
        "letterSpacing": 0.5
      },
      "body": {
        "fontFamily": "{font.display}",
        "fontSize": 19,
        "fontWeight": 400,
        "lineHeight": 1.22,
        "letterSpacing": 0
      },
      "note": {
        "fontFamily": "{font.display}",
        "fontSize": 17,
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": 0
      },
      "footer": {
        "fontFamily": "{font.display}",
        "fontSize": 22,
        "fontWeight": 800,
        "lineHeight": 1,
        "letterSpacing": 1
      }
    },
    "space": {
      "pageX": 40,
      "top": 34,
      "sectionGap": 28,
      "cardGap": 28,
      "cardPaddingX": 28,
      "cardPaddingY": 24
    },
    "radius": {
      "card": 0,
      "subtle": 1
    }
  },
  "operations": [
    {
      "name": "poster",
      "command": "frame.create",
      "params": {
        "name": "CAIR Georgia Gala Partnership Packages",
        "preset": "presentation.wide",
        "x": 640,
        "y": 3200,
        "w": 1600,
        "h": 1024,
        "style": {
          "background": "{color.ink}",
          "overflow": "hidden"
        }
      }
    },
    {
      "name": "poster_css",
      "command": "style.apply",
      "params": {
        "nodeId": "${{steps.poster.result.id}}",
        "css": {
          "display": "flex",
          "flexDirection": "column",
          "gap": "{space.sectionGap}",
          "padding": "{space.top} {space.pageX} 36 {space.pageX}",
          "position": "relative",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "name": "background_anniversary_mark",
      "command": "text.rich",
      "params": {
        "parentId": "${{steps.poster.result.id}}",
        "name": "Background anniversary numeral",
        "text": "10",
        "style": {
          "position": "absolute",
          "right": 66,
          "top": -56,
          "width": 560,
          "fontFamily": "{font.display}",
          "fontSize": 430,
          "fontWeight": 900,
          "lineHeight": 0.9,
          "color": "{color.goldDeep}",
          "opacity": 0.16
        }
      }
    },
    {
      "name": "header",
      "command": "section.create",
      "params": {
        "parentId": "${{steps.poster.result.id}}",
        "name": "Header",
        "css": {
          "display": "flex",
          "flexDirection": "column",
          "gap": 13,
          "width": "100%",
          "zIndex": 2
        },
        "children": [
          {
            "name": "CAIR-GEORGIA brand",
            "command": "text.rich",
            "params": {
              "text": "CAIR-GEORGIA",
              "style": "{type.brand}",
              "color": "#FFFFFF"
            }
          },
          {
            "name": "Gala partnership eyebrow",
            "command": "text.rich",
            "params": {
              "text": "10th Anniversary Gala Partnership",
              "style": "{type.eyebrow}",
              "color": "{color.cream}"
            }
          },
          {
            "name": "Partnership packages title",
            "command": "text.rich",
            "params": {
              "text": "Partnership Packages",
              "style": "{type.title}",
              "color": "{color.gold}"
            }
          }
        ]
      }
    },
    {
      "name": "top_rule",
      "command": "divider.create",
      "params": {
        "parentId": "${{steps.poster.result.id}}",
        "name": "Header gold rule",
        "orientation": "horizontal",
        "css": {
          "height": 2,
          "width": "100%",
          "background": "{color.rule}",
          "marginTop": 2
        }
      }
    },
    {
      "name": "pricing_grid",
      "command": "layout.pricing_grid",
