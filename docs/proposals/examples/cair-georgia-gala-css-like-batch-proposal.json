  "expected_expansion": {
    "section.create": "Creates an auto-layout frame and recursively creates child nodes.",
    "layout.pricing_grid": "Creates a grid frame, then expands each card into a semantic frame plus title, price or kicker, benefits, and eligibility rich text.",
    "card.pricing": "Creates one pricing tier with shared styles and optional per-card overrides.",
    "text.rich": "Creates a text node from a string or span array; span styles map to Figma text ranges.",
    "style.apply": "Applies CSS-like layout, paint, border, transform, and positioning params to an existing node.",
    "divider.create": "Creates a semantic line or rectangle with orientation-aware sizing."
  }
