            "css": {
              "gridColumn": "1 / span 1",
              "gridRow": "1"
            }
          },
          {
            "name": "Platinum partnership card",
            "tier": "Platinum",
            "price": "$5,000",
            "benefits": [
              "Half page ad in program booklet",
              "Double booth in prefunction area",
              "One guest table - 10 seats",
              "Social media spotlight",
              "Logo and recognition during program",
              "Logo on CAIR-Georgia website for a year"
            ],
            "css": {
              "gridColumn": "2 / span 1",
              "gridRow": "1"
            }
          },
          {
            "name": "Gold partnership card",
            "tier": "Gold",
            "price": "$2,500",
            "benefits": [
              "Quarter page ad in program booklet",
              "One booth in prefunction area",
              "One guest table - 10 seats",
              "Social media spotlight",
              "Logo and recognition in program",
              "Logo on CAIR-Georgia website for a year"
            ],
            "css": {
              "gridColumn": "3 / span 1",
              "gridRow": "1"
            }
          },
          {
            "name": "Silver partnership card",
            "tier": "Silver",
            "price": "$1,600",
            "benefits": [
              "One booth",
              "One table",
              "Booklet mention",
              "Logo and recognition in program",
              "Social media spotlight",
              "Logo on CAIR-Georgia website for a year"
            ],
            "eligibility": "Medium businesses, law firms, masajid",
            "css": {
              "gridColumn": "4 / span 1",
              "gridRow": "1"
            }
          },
          {
            "name": "Bronze partnership card",
            "tier": "Bronze",
            "price": "$1,000",
            "benefits": [
              "One booth",
              "5 tickets",
              "Logo and recognition during program",
              "Social media spotlight",
              "Logo on CAIR-Georgia website for a year"
            ],
            "eligibility": "Masajid, Islamic schools, local nonprofits only",
            "css": {
              "gridColumn": "1 / span 1",
              "gridRow": "2"
            }
          },
          {
            "name": "Community organization card",
            "tier": "Community Organization",
            "price": "$500",
            "benefits": [
              "One booth OR half page ad in program booklet",
              "2 tickets",
              "Social media spotlight",
              "Logo on CAIR-Georgia website for a year"
            ],
            "eligibility": "Small community business or small nonprofit only",
            "css": {
              "gridColumn": "2 / span 1",
              "gridRow": "2"
            }
          },
          {
            "name": "Business showcase opportunity card",
            "tier": "Business Showcase Opportunity",
            "kicker": "(limit of 10)",
            "benefits": [
              "Business provides free samples for all attendees in prefunction space",
              "If offering samples for sale, price per unit not to exceed $2",
