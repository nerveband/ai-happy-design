          "gridTemplateColumns": "repeat(4, minmax(0, 1fr))",
          "gridAutoRows": "minmax(286, auto)",
          "columnGap": "{space.cardGap}",
          "rowGap": 42,
          "width": "100%",
          "zIndex": 2
        },
        "cardDefaults": {
          "command": "card.pricing",
          "css": {
            "display": "flex",
            "flexDirection": "column",
            "gap": 12,
            "padding": "{space.cardPaddingY} {space.cardPaddingX}",
            "background": "transparent",
            "borderLeft": "2px solid {color.rule}",
            "borderRadius": "{radius.card}",
            "minHeight": 286
          },
          "titleStyle": "{type.tierName}",
          "priceStyle": "{type.price}",
          "bodyStyle": "{type.body}",
          "noteStyle": "{type.note}",
          "colors": {
            "title": "{color.gold}",
            "price": "{color.cream}",
            "body": "{color.cream}",
            "note": "{color.creamMuted}",
            "rule": "{color.rule}"
