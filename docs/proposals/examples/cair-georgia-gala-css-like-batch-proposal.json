{
  "name": "cair_georgia_gala_partnership_packages_css_like_proposal",
  "description": "Proposed high-level batch payload for recreating the CAIR Georgia gala partnership packages screenshot with CSS-like layout, semantic sections, pricing cards, and rich text blocks.",
  "intent": {
    "status": "proposal",
    "source": "CAIR Georgia 10th Anniversary Gala partnership packages screenshot",
    "implementation_note": "This file intentionally uses proposed commands and CSS-like params. It is not expected to run until the main command layer maps these commands to concrete Figma operations.",
    "design_goals": [
      "Reduce manual x/y positioning in favor of CSS-style layout primitives.",
      "Make pricing tiers first-class cards with structured content.",
      "Support rich text spans so headings, prices, bullets, and eligibility notes can share one semantic text block.",
      "Keep every created layer semantically named."
    ]
  },
  "tokens": {
    "color": {
      "ink": "#050606",
      "inkRaised": "#10100E",
      "gold": "#E5AD43",
      "goldDeep": "#C08A2E",
      "cream": "#F8F4EC",
      "creamMuted": "#CFC4AD",
      "rule": "#D89E36"
    },
    "font": {
      "display": "Brandon Grotesque",
      "fallback": "Inter"
    },
    "type": {
      "brand": {
        "fontFamily": "{font.display}",
        "fontSize": 62,
        "fontWeight": 900,
        "lineHeight": 0.95,
        "letterSpacing": 0
