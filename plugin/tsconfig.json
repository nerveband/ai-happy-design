{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES2015", "ES2017"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "typeRoots": ["node_modules/@figma"]
  },
  "include": [
    "src/main.ts",
    "src/handlers/**/*.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": [
    "src/ui/**/*.ts",
    "src/ws/**/*.ts"
  ]
}
