{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["DOM", "ES2015", "ES2017"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "src/ui/**/*.ts",
    "src/ws/**/*.ts",
    "src/utils/channel.ts",
    "src/utils/relay.ts"
  ]
}
